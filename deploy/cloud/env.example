# 复制成 deploy/cloud/env 后按实际填写（env 已被 .gitignore 排除）
# 用法：./deploy/cloud/up.sh 会自动读取 deploy/cloud/env

# ---- 镜像仓库 ----
# 云上部署用【VPC 域名】：ECS 在同地域 VPC 内，走内网更快，且避开个人版的公网拉取限制
DSH_REGISTRY=crpi-ba3g3wzinl7gtexa-vpc.cn-beijing.personal.cr.aliyuncs.com/dsh_ljx
DSH_VERSION=0.2.1-alpha.4
REPO_TAG=0.1.0

# 本地构建推送要用【公网域名】（VPC 域名在你的 Mac 上解析不了）。
# 注意：两个域名指向同一实例，registry 只按 repo 路径存，所以
#   本地 tag 成 <公网>/dsh_ljx/dsh-control:0.1.0 并 push
#   集群里引用 <VPC>/dsh_ljx/dsh-control:0.1.0
# 是同一份镜像。构建时用这个变量，不要用上面的 DSH_REGISTRY：
#   export DSH_REGISTRY=crpi-ba3g3wzinl7gtexa.cn-beijing.personal.cr.aliyuncs.com/dsh_ljx

# ---- 域名与入口 ----
DSH_DOMAIN=dsh.example.com
# 镜像 tag：默认等于 DSH_VERSION。只想重建镜像（改 profile/Dockerfile）而不升 DSH 时单独设它。
# 推同一个 tag 会被 push-images.sh 拦下（IfNotPresent 不会重拉）；确实要覆盖加 ALLOW_TAG_OVERWRITE=1。
# IMAGE_TAG=0.2.1-alpha.4-r2

# 入口模式三选一（默认：ServiceLB + HTTP，仅验证用）：
#   ALB_MODE=1       云上 ALB 终止 TLS → 集群内 HTTP + NodePort + Local
#   WITH_ISTIO=1     集群内 Istio 终止 TLS
# PUBLIC_SCHEME 默认就是 auto：按 X-Forwarded-Proto（ALB/Istio 会带）判断，
# 没有就退回请求本身的协议；写死 http/https 可强制固定。
# PUBLIC_SCHEME=auto
# ALB_MODE=1
# NODE_PORT=31147          # ALB 后端端口，固定住避免集群重建后漂移（范围 30000-32767）
# WITH_ISTIO=1 时才需要下面两项
# EDGE_ISSUER=letsencrypt-prod
# SSO_URL=https://sso.example.com/login

# ---- 部署选项 ----
# DISABLE_KATA=1          # 普通 ECS（无 /dev/kvm）时默认会自动降级，不用手动设
# DSH_STORAGE_CLASS=local-path
# PULL_SECRET=acr-pull
# ADMIN_SUBJECT=alice@corp
# KEEP_DEV_LOGIN=1

# 模型密钥建议用环境变量传，不要写进文件：
#   DEEPSEEK_API_KEY=sk-... ./deploy/cloud/up.sh
